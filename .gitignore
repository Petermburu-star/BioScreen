# Environment
.env
*.pem
*.key

# Python
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# External cloned repos (re-clonable, 100+ MB)
external/

# Data (regenerable, large)
data/raw/*
!data/raw/.gitkeep
data/models/*
!data/models/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Notebooks
*.nbconvert.ipynb

# OS
.DS_Store

# Stray HuggingFace artifacts
data/*.json
data/*.pdb

# ---------- PRIVATE — do not commit ----------
# Handoff / session state document (personal notes, not for public repo)
docs/HANDOFF.md
docs/HANDOFF.local.md
**/HANDOFF.md
**/.handoff/

# Editor/script backups
*.bak
*.bak2
*.bak3
*.bak4

# Reference downloads (AAindex, Pfam HMMs, Stockholm alignments) — regenerable
data/reference/
